{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    },
    {
      "src": "cosmetic-backend-proxy/server.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/cosmetic-backend-proxy/server.js"
    },
    {
      "src": "/(.*)",
      "dest": "/"
    }
  ]
}